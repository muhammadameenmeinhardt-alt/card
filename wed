  <script>
    (function () {
      var overlay = document.getElementById('curtainOverlay');
      var curtainHint = document.getElementById('curtainHint');
      var stageNames = document.getElementById('stageNames');
      var curtainLeft = document.getElementById('curtainLeft');
      var curtainRight = document.getElementById('curtainRight');
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var stage = 'closed'; // closed -> open -> revealed
      var scrollRevealStarted = false;
      var sprinklesStarted = false;
      var tapLabel = curtainHint.querySelector('.tap-label');

      function startSprinkles() {
        if (sprinklesStarted) return;
        sprinklesStarted = true;

        var layer = document.createElement('div');
        layer.className = 'sprinkle-layer';
        layer.setAttribute('aria-hidden', 'true');
        document.body.appendChild(layer);

        var flowerGlyphs = ['\u2740', '\u273F', '\u2741'];
        var snowGlyph = '\u2744';
        var tints = ['#f5b8c9', '#eecf85', '#c86d91', '#f9d8e2'];
        var total = 26;

        for (var i = 0; i < total; i++) {
          var isSnow = i % 3 === 0;
          var piece = document.createElement('span');
          piece.className = 'sprinkle' + (isSnow ? ' is-snow' : '');
          piece.textContent = isSnow ? snowGlyph : flowerGlyphs[Math.floor(Math.random() * flowerGlyphs.length)];

          piece.style.setProperty('--left', (Math.random() * 100).toFixed(1) + '%');
          piece.style.setProperty('--size', (12 + Math.random() * 14).toFixed(0) + 'px');
          piece.style.setProperty('--dur', (8 + Math.random() * 9).toFixed(1) + 's');
          piece.style.setProperty('--delay', (Math.random() * 10).toFixed(1) + 's');
          piece.style.setProperty('--drift', (Math.random() * 60 - 30).toFixed(0) + 'px');
          piece.style.setProperty('--rot', (200 + Math.random() * 400).toFixed(0) + 'deg');

          if (!isSnow) {
            piece.style.setProperty('--tint', tints[Math.floor(Math.random() * tints.length)]);
          }

          layer.appendChild(piece);
        }
      }

      function decorateCurtain(panel) {
        var flowerGlyphs = ['\u2740', '\u273F', '\u2741'];
        var flowerCount = 6;
        for (var i = 0; i < flowerCount; i++) {
          var flower = document.createElement('span');
          flower.className = 'curtain-flower';
          flower.setAttribute('aria-hidden', 'true');
          flower.style.left = (10 + Math.random() * 68) + '%';
          flower.style.top = (8 + Math.random() * 80) + '%';
          flower.style.fontSize = (16 + Math.random() * 16) + 'px';
          flower.style.transform = 'rotate(' + (Math.random() * 40 - 20) + 'deg)';
          flower.textContent = flowerGlyphs[Math.floor(Math.random() * flowerGlyphs.length)];
          panel.appendChild(flower);
        }

        var lightCount = 8;
        for (var j = 0; j < lightCount; j++) {
          var light = document.createElement('span');
          light.className = 'curtain-light';
          light.setAttribute('aria-hidden', 'true');
          light.style.left = (6 + Math.random() * 86) + '%';
          light.style.top = (6 + Math.random() * 88) + '%';
          light.style.animationDelay = (Math.random() * 2.6).toFixed(2) + 's';
          panel.appendChild(light);
        }
      }

      function initScrollReveal() {
        if (scrollRevealStarted) return;
        scrollRevealStarted = true;

        var revealEls = document.querySelectorAll('.reveal');

        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.18 });

          revealEls.forEach(function (el) { io.observe(el); });
        } else {
          revealEls.forEach(function (el) { el.classList.add('in-view'); });
        }
      }

      function showProceedHint() {
        tapLabel.textContent = 'Tap to view invitation';
        curtainHint.classList.add('on-stage');
        curtainHint.classList.remove('fade');
        overlay.setAttribute('aria-label', 'Continue to the invitation');
      }

      function openCurtains() {
        if (stage !== 'closed') return;
        stage = 'open';

        startSprinkles();
        curtainHint.classList.add('fade');

        if (reduceMotion) {
          stageNames.classList.add('show');
          showProceedHint();
          return;
        }

        overlay.classList.add('open');

        setTimeout(function () {
          stageNames.classList.add('show');
        }, 650);

        setTimeout(function () {
          showProceedHint();
        }, 1500);
      }

      function revealInvitation() {
        if (stage !== 'open') return;
        stage = 'revealed';

        curtainHint.classList.add('fade');
        overlay.classList.add('advance');
        document.body.classList.add('opened');
        initScrollReveal();

        setTimeout(function () {
          overlay.style.display = 'none';
        }, reduceMotion ? 0 : 950);
      }

      function handleActivate() {
        if (stage === 'closed') {
          openCurtains();
        } else if (stage === 'open') {
          revealInvitation();
        }
      }

      decorateCurtain(curtainLeft);
      decorateCurtain(curtainRight);

      overlay.addEventListener('click', handleActivate);
      overlay.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleActivate();
        }
      });
    })();
  </script>
